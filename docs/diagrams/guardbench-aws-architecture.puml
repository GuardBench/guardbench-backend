@startuml

!define AWSPuml https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v23.0/dist
!include AWSPuml/AWSCommon.puml
!include AWSPuml/Analytics/SageMaker.puml
!include AWSPuml/ApplicationIntegration/SimpleQueueService.puml
!include AWSPuml/Containers/ElasticContainerService.puml
!include AWSPuml/Database/RDS.puml
!include AWSPuml/NetworkingContentDelivery/CloudFront.puml
!include AWSPuml/NetworkingContentDelivery/ElasticLoadBalancingApplicationLoadBalancer.puml
!include AWSPuml/Storage/SimpleStorageService.puml

left to right direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam RoundCorner 12
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.5
skinparam packageBorderColor #CBD5E1
skinparam packageBackgroundColor #F8FAFC

package "Users & External Systems" #FFF7ED {
  actor "User" as user
  component "Frontend\nReact SPA" as frontend #FFFFFF
  component "Performance\nRunner" as runner #FFFFFF
  rectangle "Application Target\nOpenAI-compatible HTTP" as target #FFFFFF
}

package "AWS Cloud" #F8FAFC {
  CloudFront(cloudfront, "Amazon CloudFront", "SPA + API routing")
  SimpleStorageService(frontend_s3, "Amazon S3", "Frontend assets")
  SageMaker(classifier, "Amazon SageMaker", "Response classifier")
  SimpleStorageService(results_s3, "Amazon S3", "Performance results")

  package "GuardBench VPC" #EFF6FF {
    ElasticLoadBalancingApplicationLoadBalancer(alb, "Application Load Balancer", "HTTP :80")

    package "ECS Fargate Service" #FFFFFF {
      ElasticContainerService(ecs, "Amazon ECS", "API + Outbox + workers")
    }

    SimpleQueueService(sqs, "Amazon SQS", "resolve · work-items · finalize")
    RDS(rds, "Amazon RDS", "PostgreSQL")
  }
}

' Primary request path.
user --> frontend
frontend --> cloudfront : HTTPS
cloudfront --> frontend_s3 : static assets
cloudfront --> alb : /api/*
alb --> ecs : :8080

' Async execution and evaluation boundaries.
ecs --> sqs : async TestRun events
ecs --> rds : source of truth
ecs --> target : HTTP request
target --> ecs : response
ecs --> classifier : classify response

' Controlled performance workload and result archive.
runner --> alb : E2E workload
runner --> results_s3 : result artifacts

' Alignment anchors keep the presentation path horizontal.
frontend -[hidden]right-> cloudfront
cloudfront -[hidden]right-> alb
alb -[hidden]right-> ecs
ecs -[hidden]right-> rds

note bottom of ecs
  One service, horizontally scalable.
end note
@enduml
