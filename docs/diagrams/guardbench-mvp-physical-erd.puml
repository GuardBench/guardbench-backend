@startuml
!pragma layout smetana
title GuardBench MVP PostgreSQL 물리 ERD

hide methods
hide stereotypes
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName "Droid Sans Fallback"
skinparam entity {
  BackgroundColor White
  BorderColor #374151
  HeaderBackgroundColor #E5E7EB
}

entity "test_suite" as test_suite {
  * id : BIGINT <<PK, sequence>>
  --
  * name : TEXT
    description : TEXT
  * created_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "test_case" as test_case {
  * id : BIGINT <<PK, sequence>>
  --
  * test_suite_id : BIGINT <<FK>>
  * name : TEXT
  * input : TEXT
  * expected_action : VARCHAR(16)
  * severity : VARCHAR(16)
  * category : TEXT
  * created_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "target_reference" as target_reference {
  * reference_id : TEXT <<PK>>
  --
  * target_type : VARCHAR(32) = HTTP_ENDPOINT
}

entity "http_endpoint_target" as http_endpoint_target {
  * reference_id : TEXT <<PK, FK>>
  --
  * endpoint_url : TEXT
  * model : TEXT
    requested_revision : TEXT
}

entity "evaluator_reference" as evaluator_reference {
  * reference_id : TEXT <<PK>>
  --
  * provider_code : VARCHAR(32)
  * model_id : TEXT
}

entity "test_run" as test_run {
  * id : BIGINT <<PK, sequence>>
  --
  * test_suite_id : BIGINT <<historical identity>>
  * status : VARCHAR(16)
  * test_case_count : INTEGER
  * processed_test_case_count : INTEGER
  * target_reference_id : TEXT <<UK, FK>>
  * evaluator_reference_id : TEXT <<FK>>
    execution_outcome : VARCHAR(16)
  * created_at : TIMESTAMPTZ(6)
    started_at : TIMESTAMPTZ(6)
    completed_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "test_case_snapshot" as snapshot {
  * id : BIGINT <<PK, sequence>>
  --
  * test_run_id : BIGINT <<FK>>
  * source_test_case_id : BIGINT <<historical identity>>
  * name : TEXT
  * input : TEXT
  * expected_action : VARCHAR(16)
  * severity : VARCHAR(16)
  * category : TEXT
  * created_at : TIMESTAMPTZ(6)
  --
  UK (test_run_id, source_test_case_id)
}

entity "test_execution" as execution {
  * snapshot_id : BIGINT <<PK, FK>>
  --
  * result_status : VARCHAR(16)
    application_response : TEXT
    evaluator_verdict : VARCHAR(16)
    error_stage : VARCHAR(32)
    error_code : TEXT
    error_message : TEXT
    started_at : TIMESTAMPTZ(6)
    completed_at : TIMESTAMPTZ(6)
}

entity "assertion_result" as assertion {
  * snapshot_id : BIGINT <<PK, FK>>
  --
  * assertion_status : VARCHAR(16)
  * created_at : TIMESTAMPTZ(6)
}

entity "change_result" as change_result {
  * snapshot_id : BIGINT <<PK, FK>>
  --
  * comparability_status : VARCHAR(32)
    change_type : VARCHAR(64)
  * created_at : TIMESTAMPTZ(6)
}

entity "quality_gate_result" as quality_gate {
  * test_run_id : BIGINT <<PK, FK>>
  --
  * gate_status : VARCHAR(32)
    assertion_pass_rate : DOUBLE PRECISION
    execution_success_rate : DOUBLE PRECISION
  * created_at : TIMESTAMPTZ(6)
}

entity "test_run_idempotency" as idempotency {
  * idempotency_key : VARCHAR(100) <<PK>>
  --
  * request_fingerprint : CHAR(64)
  * test_run_id : BIGINT <<UK, FK>>
  * created_at : TIMESTAMPTZ(6)
  * expires_at : TIMESTAMPTZ(6)
}

entity "test_run_resolution_claim" as resolution_claim {
  * test_run_id : BIGINT <<PK, FK>>
  --
  * claim_token : UUID
  * lease_until : TIMESTAMPTZ(6)
  * attempt_count : INTEGER
  * claimed_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "test_execution_claim" as execution_claim {
  * snapshot_id : BIGINT <<PK, FK>>
  --
  * claim_token : UUID
  * lease_until : TIMESTAMPTZ(6)
  * attempt_count : INTEGER
  * claimed_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "outbox_event" as outbox {
  * event_id : UUID <<PK>>
  --
  * event_type : VARCHAR(32)
  * schema_version : SMALLINT
  * payload : JSONB
  * deduplication_key : TEXT <<UK>>
  * status : VARCHAR(16)
  * created_at : TIMESTAMPTZ(6)
    published_at : TIMESTAMPTZ(6)
}

test_suite ||--o{ test_case : 포함
test_suite ||..o{ test_run : 이력 식별자
target_reference ||--o| test_run : 참조
target_reference ||--|| http_endpoint_target : HTTP Target 상세
evaluator_reference ||--o{ test_run : 분류기 참조
test_run ||--|{ snapshot : 고정
test_case ||..o{ snapshot : 이력 식별자
snapshot ||--o| execution : 단일 Target
snapshot ||--o| execution_claim : 기술적 lease
test_run ||--o| idempotency : 요청 재처리
test_run ||--o| resolution_claim : 기술적 lease
snapshot ||--o| assertion : 기대 동작 vs 평가 결과
snapshot ||--o| change_result : 평가 결과 저장
test_run ||--o| quality_gate : 최종 평가
outbox ..> test_run : payload 참조만

note right of target_reference
  현재 Target 계약은 HTTP_ENDPOINT 하나뿐이다.
  test_run.target_reference_id는 NOT NULL이며 UNIQUE이다.
end note

note right of evaluator_reference
  TestRun에서 사용하는 전역 Response Behavior Classifier의
  provider/model 식별자를 저장한다.
  test_run.evaluator_reference_id는 필수이다.
end note

note right of http_endpoint_target
  endpoint_url과 OpenAI-compatible model은 필수이다.
  requested_revision은 선택 메타데이터이다.
end note

note bottom of execution
  성공한 실행은 AI Application 응답과 정규화된
  classifier verdict ALLOW/BLOCK을 함께 저장한다.
end note

note bottom of quality_gate
  행이 없으면 아직 평가하지 않은 상태이다.
  NOT_EVALUATED이면 모든 metric이 NULL이다.
end note

legend left
  이 다이어그램은 Flyway V1이 생성한 현재 물리 스키마이다.
  TestCase → TestSuite는 ON DELETE RESTRICT를 사용한다.
  Snapshot source ID와 TestRun suite ID는 FK가 없는 이력용 scalar이다.
  Claim 관계는 기술적 lease이며 Domain ID나 Aggregate Repository가 아니다.
endlegend

@enduml
