@startuml
!pragma layout smetana
title GuardBench MVP PostgreSQL Physical ERD

hide methods
hide stereotypes
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
  BackgroundColor White
  BorderColor #374151
  HeaderBackgroundColor #E5E7EB
}

entity "test_suite" as test_suite {
  * id : BIGINT <<PK, sequence>>
  --
  * name : TEXT
    description : TEXT
  * created_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "test_case" as test_case {
  * id : BIGINT <<PK, sequence>>
  --
  * test_suite_id : BIGINT <<FK>>
  * name : TEXT
  * input : TEXT
  * expected_action : VARCHAR(16)
  * severity : VARCHAR(16)
  * category : TEXT
  * created_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "test_run" as test_run {
  * id : BIGINT <<PK, sequence>>
  --
  * test_suite_id : BIGINT <<historical identity>>
  * status : VARCHAR(16)
  * test_case_count : INTEGER
  * processed_test_case_count : INTEGER
  * target_reference_id : TEXT <<UK, FK>>
    evaluation_checks : TEXT <<nullable legacy>>
    evaluation_strictness : VARCHAR(16) <<nullable legacy>>
    evaluator_reference_id : TEXT <<FK, nullable legacy>>
    execution_outcome : VARCHAR(16)
  * created_at : TIMESTAMPTZ(6)
    started_at : TIMESTAMPTZ(6)
    completed_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "target_reference" as target_reference {
  * reference_id : TEXT <<PK>>
  --
  * target_type : VARCHAR(32)
}

entity "bedrock_guardrail_target" as bedrock_target {
  * reference_id : TEXT <<PK, FK>>
  --
  * guardrail_identifier : TEXT
  * requested_revision : TEXT
    resolved_revision : TEXT
}

entity "http_endpoint_target" as http_endpoint_target {
  * reference_id : TEXT <<PK, FK>>
  --
  * endpoint_url : TEXT
  * model : TEXT
    requested_revision : TEXT
}

entity "evaluator_reference" as evaluator_reference {
  * reference_id : TEXT <<PK>>
  --
  * evaluator_type : VARCHAR(32)
}

entity "bedrock_guardrail_evaluator" as bedrock_evaluator {
  * reference_id : TEXT <<PK, FK>>
  --
  * guardrail_identifier : TEXT
  * guardrail_revision : VARCHAR(8)
}

entity "test_case_snapshot" as snapshot {
  * id : BIGINT <<PK, sequence>>
  --
  * test_run_id : BIGINT <<FK>>
  * source_test_case_id : BIGINT <<historical identity>>
  * name : TEXT
  * input : TEXT
  * expected_action : VARCHAR(16)
  * severity : VARCHAR(16)
  * category : TEXT
  * created_at : TIMESTAMPTZ(6)
  --
  UK (test_run_id, source_test_case_id)
}

entity "test_execution" as execution {
  * snapshot_id : BIGINT <<PK, FK>>
  --
  * result_status : VARCHAR(16)
    application_response : TEXT
    evaluator_verdict : VARCHAR(16)
    error_stage : VARCHAR(32)
    error_code : TEXT
    error_message : TEXT
    started_at : TIMESTAMPTZ(6)
    completed_at : TIMESTAMPTZ(6)
}

entity "assertion_result" as assertion {
  * snapshot_id : BIGINT <<PK, FK>>
  --
  * assertion_status : VARCHAR(16)
  * created_at : TIMESTAMPTZ(6)
}

entity "change_result" as change_result {
  * snapshot_id : BIGINT <<PK, FK>>
  --
  * comparability_status : VARCHAR(32)
    change_type : VARCHAR(64)
  * created_at : TIMESTAMPTZ(6)
}

entity "quality_gate_result" as quality_gate {
  * test_run_id : BIGINT <<PK, FK>>
  --
  * gate_status : VARCHAR(32)
    assertion_pass_rate : DOUBLE PRECISION
    execution_success_rate : DOUBLE PRECISION
  * created_at : TIMESTAMPTZ(6)
}

entity "test_run_idempotency" as idempotency {
  * idempotency_key : VARCHAR(100) <<PK>>
  --
  * request_fingerprint : CHAR(64)
  * test_run_id : BIGINT <<UK, FK>>
  * created_at : TIMESTAMPTZ(6)
  * expires_at : TIMESTAMPTZ(6)
}

entity "test_run_resolution_claim" as resolution_claim {
  * test_run_id : BIGINT <<PK, FK>>
  --
  * claim_token : UUID
  * lease_until : TIMESTAMPTZ(6)
  * attempt_count : INTEGER
  * claimed_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "test_execution_claim" as execution_claim {
  * snapshot_id : BIGINT <<PK, FK>>
  --
  * claim_token : UUID
  * lease_until : TIMESTAMPTZ(6)
  * attempt_count : INTEGER
  * claimed_at : TIMESTAMPTZ(6)
  * updated_at : TIMESTAMPTZ(6)
}

entity "outbox_event" as outbox {
  * event_id : UUID <<PK>>
  --
  * event_type : VARCHAR(32)
  * schema_version : SMALLINT
  * payload : JSONB
  * deduplication_key : TEXT <<UK>>
  * status : VARCHAR(16)
  * created_at : TIMESTAMPTZ(6)
    published_at : TIMESTAMPTZ(6)
}

test_suite ||--o{ test_case : contains
test_suite ||..o{ test_run : historical identity
target_reference ||--o| test_run : referenced by
target_reference ||--o| bedrock_target : provider detail
target_reference ||--o| http_endpoint_target : provider detail
evaluator_reference ||--o| bedrock_evaluator : provider detail
evaluator_reference ||--o{ test_run : immutable evaluator snapshot
test_run ||--|{ snapshot : fixes
test_case ||..o{ snapshot : historical identity
snapshot ||--o| execution : single target
snapshot ||--o| execution_claim : technical lease
test_run ||--o| idempotency : request replay
test_run ||--o| resolution_claim : technical lease
snapshot ||--o| assertion : expected vs actual
snapshot ||--o| change_result : legacy, no new writes
test_run ||--o| quality_gate : final evaluation
outbox ..> test_run : payload reference only

note right of target_reference
  target_type: BEDROCK_GUARDRAIL | HTTP_ENDPOINT
  Provider detail is stored in the matching table.
  test_run.target_reference_id is NOT NULL with a UNIQUE
  constraint, so at most one TestRun per target_reference.
  New TestRuns register HTTP_ENDPOINT only;
  bedrock_guardrail_target is retained V3 legacy data.
end note

note right of evaluator_reference
  evaluator_type: BEDROCK_GUARDRAIL only (V6).
  test_run.evaluator_reference_id is nullable and has no
  UNIQUE constraint, so the schema permits reuse across Runs.
  New TestRuns always fix checks + strictness + evaluator
  reference together (ck_test_run_evaluation_profile_pair).
end note

note right of http_endpoint_target
  V4 adds HTTP_ENDPOINT persistence; V6 adds requested revision.
  V5 requires an http/https URL with host-like text.
  V7 adds the OpenAI-compatible model; V8 makes it NOT NULL.
  Public API accepts HTTP_ENDPOINT only.
end note

note right of test_case
  Public DELETE is physical.
  Historical Snapshot values remain independent.
end note

note bottom of execution
  PK limits each Snapshot to one row.
  Only terminal result states are stored.
end note

note bottom of change_result
  V3 removes existing rows.
  Single-target TestRun creates no new rows.
end note

note bottom of quality_gate
  No row = not evaluated yet.
  NOT_EVALUATED = every metric is NULL.
end note

legend left
  Current TestCase → TestSuite uses ON DELETE RESTRICT.
  Snapshot source and TestRun suite IDs are historical scalars without FKs.
  Outbox has no test_run_id column; its payload
  carries the immutable event identifiers.
  Claim relations are technical leases, not Domain IDs
  or Aggregate Repositories.
  Diagram reflects Flyway V1 through V12.
endlegend

@enduml
