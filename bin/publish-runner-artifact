#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${PERFORMANCE_RESULTS_BUCKET:-}" ]]; then
  echo "PERFORMANCE_RESULTS_BUCKET is required." >&2
  exit 2
fi
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
artifact="${1:-$root/build/runner-artifact/runner.tar.gz}"
if [[ ! -f "$artifact" ]]; then
  echo "Runner artifact not found: $artifact" >&2
  exit 2
fi
aws s3 cp "$artifact" "s3://${PERFORMANCE_RESULTS_BUCKET}/performance/bootstrap/runner.tar.gz" \
  --metadata "app-revision=${APP_REVISION:-unknown}"
